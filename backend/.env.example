# Supabase Project
# Get these from your Supabase project dashboard: Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Database (Supabase PostgreSQL)
# For Vercel/serverless, copy the Transaction pooler connection string
# from the Supabase Connect panel. It uses an IPv4 pooler host and port 6543.
# Make sure the password is URL-encoded if it contains special characters
DATABASE_URL=postgresql://postgres.project-ref:password@aws-1-region.pooler.supabase.com:6543/postgres?sslmode=require

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
